<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CodexQuotaViewer.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\WindowsTray\src-tauri\icons\icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <CoreHostConfiguration Condition="'$(Configuration)' == 'Debug'">debug</CoreHostConfiguration>
    <CoreHostConfiguration Condition="'$(Configuration)' != 'Debug'">release</CoreHostConfiguration>
    <CoreHostReleaseFlag Condition="'$(Configuration)' != 'Debug'">--release</CoreHostReleaseFlag>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251106002" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\WindowsTray\src-tauri\icons\icon.ico" Link="Assets\icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Sources\CodexQuotaViewer\Resources\openai-blossom-dark.svg" Link="Assets\openai-blossom-dark.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="BuildCoreHost" BeforeTargets="PrepareForBuild" Condition="'$(SkipCoreHostBuild)' != 'true'">
    <Exec Command="cargo build --manifest-path &quot;$(MSBuildProjectDirectory)\..\WindowsCoreHost\Cargo.toml&quot; $(CoreHostReleaseFlag)"
          IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <Target Name="CopyCoreHost" AfterTargets="Build" Condition="'$(SkipCoreHostBuild)' != 'true'">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\WindowsCoreHost\target\$(CoreHostConfiguration)\codex-quota-viewer-core-host.exe"
          DestinationFiles="$(OutDir)codex-quota-viewer-core-host.exe" />
  </Target>

  <Target Name="CopyCoreHostToPublish" AfterTargets="Publish" Condition="'$(SkipCoreHostBuild)' != 'true'">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\WindowsCoreHost\target\$(CoreHostConfiguration)\codex-quota-viewer-core-host.exe"
          DestinationFiles="$(PublishDir)codex-quota-viewer-core-host.exe" />
  </Target>
</Project>

<Application
    x:Class="CodexQuotaViewer.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="WidgetMint">#86E4B1</Color>
      <SolidColorBrush x:Key="WidgetMintBrush" Color="{StaticResource WidgetMint}" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
